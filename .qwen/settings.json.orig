{
  "tools": {
    "approvalMode": "default"
  },
  "$version": 2,
  "context": {
    "fileName": [
      "context.md"
    ],
    "includeDirectories": [
      ".agent"
    ],
    "loadFromIncludeDirectories": true,
    "fileFiltering": {
      "respectGitIgnore": false
    }
  },
  "experimental": {
    "skills": true
  }
}