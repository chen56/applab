{
  "general": {
    "vimMode": true,
    "preferredEditor": "code",
    "checkpointing": {
      "enabled": true
    },
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d",
      "maxCount": 100
    }
  }, 
  "tools": {
    "sandbox": "false",
    "enabledTools": [
      "web_search",
      "run_shell_command",
      "file_management"
    ]
  },
  "telemetry": {
    "enabled": true,
    "target": "local",
    "otlpEndpoint": "http://localhost:4317",
    "logPrompts": true
  },
  "privacy": {
    "usageStatisticsEnabled": true
  },
  "context": {
    "fileName": [
      "context.md"
    ],
    "includeDirectories": ["build/ai"]

  },
  "advanced": {
    "excludedEnvVars": [
      "DEBUG",
      "DEBUG_MODE",
      "NODE_ENV"
    ]
  },
  "experimental": {
    "skills": true,
    "plan":true,
    "cliHelpAgentSettings": {
      "enabled": true
    },
    "codebaseInvestigatorSettings": {
      "enabled": true,
      "maxNumTurns": 5
    }
  }
}