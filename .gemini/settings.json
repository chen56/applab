{
  "general": {
    "vimMode": true,
    "preferredEditor": "code",
    "checkpointing": {
      "enabled": true
    },
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d",
      "maxCount": 100
    }
  }, 
  "tools": {
    "sandbox": "true"
  },
  "privacy": {
    "usageStatisticsEnabled": true
  },
  "context": {
    "fileName": [
      "context.md"
    ],
    "includeDirectories": [".agent"]
  },
  "advanced": {
    "excludedEnvVars": [
      "DEBUG",
      "DEBUG_MODE",
      "NODE_ENV"
    ]
  },
  "experimental": {
    "skills": true,
    "plan":true,
    "cliHelpAgentSettings": {
      "enabled": true
    },
    "codebaseInvestigatorSettings": {
      "enabled": true,
      "maxNumTurns": 5
    }
  }
}